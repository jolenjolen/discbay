[Unit]
Description=DiscBay notification island (GTK4 frontend)
Documentation=https://github.com/jolenjolen/discbay
PartOf=graphical-session.target
After=graphical-session.target discbayd.service
Wants=discbayd.service

[Service]
ExecStart=/usr/bin/discbay-island
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
